{
  "manifest_version": 3,
  "name": "NodeShot",
  "version": "2.0.0",
  "description": "Pick any element on the page and capture it as a PNG — copy it to the clipboard or download it.",
  "homepage_url": "https://github.com/ericfurspan/nodeshot",
  "minimum_chrome_version": "111",
  "action": {
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    },
    "default_title": "NodeShot"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "clipboardWrite"],
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
