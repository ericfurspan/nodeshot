{
  "manifest_version": 3,
  "name": "NodeSnip",
  "version": "2.0.3",
  "description": "Capture any webpage element as a PNG. Copy or download it instantly. Runs only when clicked, with local processing and no tracking.",
  "homepage_url": "https://github.com/ericfurspan/NodeSnip",
  "minimum_chrome_version": "111",
  "action": {
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    },
    "default_title": "NodeSnip"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "clipboardWrite"],
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
